.class public final Li42;
.super Ly44;


# instance fields
.field public q:I

.field public w:I


# direct methods
.method public constructor <init>(II)V
    .locals 0

    invoke-direct {p0, p1, p2}, Ly44;-><init>(II)V

    const/4 p1, -0x1

    iput p1, p0, Li42;->q:I

    const/4 p1, 0x1

    const/4 p1, 0x0

    iput p1, p0, Li42;->w:I

    return-void
.end method
