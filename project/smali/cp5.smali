.class public Lcp5;
.super Lbp5;


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lbp5;-><init>()V

    return-void
.end method

.method public constructor <init>(Ltp5;)V
    .locals 0

    invoke-direct {p0, p1}, Lbp5;-><init>(Ltp5;)V

    return-void
.end method
