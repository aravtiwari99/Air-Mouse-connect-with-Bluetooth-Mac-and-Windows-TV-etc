.class public Lmp5;
.super Llp5;


# direct methods
.method public constructor <init>(Ltp5;Landroid/view/WindowInsets;)V
    .locals 0

    invoke-direct {p0, p1, p2}, Llp5;-><init>(Ltp5;Landroid/view/WindowInsets;)V

    return-void
.end method

.method public constructor <init>(Ltp5;Lmp5;)V
    .locals 0

    invoke-direct {p0, p1, p2}, Llp5;-><init>(Ltp5;Llp5;)V

    return-void
.end method
